<launch>

     <let name="urdf_path"
          value="$(find-pkg-share warehouse_robot)/urdf/warehouse_robot.urdf.xacro" />
     <let name="rviz_config_path"
          value="$(find-pkg-share warehouse_robot)/rviz/robot_config.rviz" />
     <let name="gz_world_path"
          value="$(find-pkg-share warehouse_robot)/worlds/warehouse.sdf" />

     <node pkg="robot_state_publisher"
          exec="robot_state_publisher">
          <param name="robot_description"
               value="$(command 'xacro $(var urdf_path)')" />
     </node>

     <node pkg="rviz2"
          exec="rviz2"
          output="screen"
          args="-d $(var rviz_config_path)" />

     <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
          <arg name="gz_args" value="-r $(var gz_world_path)" />
     </include>

     <node pkg="ros_gz_bridge"
          exec="parameter_bridge"
          args="/clock@rosgraph_msgs/msg/Clock[gz.msgs.Clock"
          output="screen" />

     <node pkg="ros_gz_sim"
          exec="create"
          output="screen"
          args="-name warehouse_robot
                -topic robot_description
                -x 0
                -y 0
                -z 0"
     />

     <node pkg="controller_manager"
          exec="spawner"
          args="joint_state_broadcaster"
          output="screen" />

     <node pkg="controller_manager"
          exec="spawner"
          args="diff_drive_base_controller"
          output="screen" />

</launch>