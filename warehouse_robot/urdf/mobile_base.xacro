<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <link name="base_footprint" />

    <link name="base_link">
        <visual>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="blue" />
        </visual>
        <collision>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <xacro:box_inertia m="${chassis_mass}"
            x="${chassis_length}" y="${chassis_width}"
            z="${chassis_height}"
            origin_xyz="0 0 0" origin_rpy="0 0 0" />
    </link>

    <link name="wheel_left_link">
        <visual>
            <geometry>
                <cylinder length="${wheel_length}" radius="${wheel_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <cylinder length="${wheel_length}" radius="${wheel_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <xacro:cylinder_inertia m="${wheel_mass}"
            r="${wheel_radius}" h="${wheel_length}"
            origin_xyz="0 0 0" origin_rpy="0 0 0" />
    </link>


    <link name="wheel_right_link">
        <visual>
            <geometry>
                <cylinder length="${wheel_length}" radius="${wheel_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <cylinder length="${wheel_length}" radius="${wheel_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <xacro:cylinder_inertia m="${wheel_mass}"
            r="${wheel_radius}" h="${wheel_length}"
            origin_xyz="0 0 0" origin_rpy="0 0 0" />
    </link>

    <link name="caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius="${caster_wheel_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <sphere radius="${caster_wheel_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <xacro:sphere_inertia m="${wheel_mass}"
            r="${caster_wheel_radius}"
            origin_xyz="0 0 0" origin_rpy="0 0 0" />
    </link>

    <link name="lidar_link">
        <visual>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_length}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="black" />
        </visual>
        <collision>
            <geometry>
                <sphere radius="${caster_wheel_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
    </link>

    <gazebo reference="caster_wheel_link">
        <mu1>0.0</mu1>
        <mu2>0.0</mu2>
    </gazebo>

    <joint name="footprint_base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 ${chassis_height/2+wheel_radius}" rpy="0 0 0" />
    </joint>

    <joint name="base_right_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="wheel_right_link" />
        <origin xyz="-${chassis_length/4} -${wheel_seperation_from_center} -${chassis_height/2}"
            rpy="${pi/2} 0 0" />
        <axis xyz="0 0 -1" />
    </joint>

    <joint name="base_left_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="wheel_left_link" />
        <origin xyz="-${chassis_length/4} ${wheel_seperation_from_center} -${chassis_height/2}"
            rpy="${pi/2} 0 0" />
        <axis xyz="0 0 -1" />
    </joint>

    <joint name="base_castor_wheel_joint" type="fixed">
        <parent link="base_link" />
        <child link="caster_wheel_link" />
        <origin
            xyz="${chassis_length/4} 0 -${chassis_height/2 + wheel_radius - caster_wheel_radius}"
            rpy="0 0 0" />
    </joint>

    <joint name="base_lidar_link" type="fixed">
        <parent link="base_link" />
        <child link="lidar_link" />
        <origin xyz="${chassis_length/4} 0 ${chassis_height/2}" rpy="0 0 0"></origin>
    </joint>

</robot>