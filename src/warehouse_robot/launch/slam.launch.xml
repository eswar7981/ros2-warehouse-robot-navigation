<launch>

    <let name="slam_params_file" value="$(find-pkg-share warehouse_robot)/config/slam_toolbox.yaml" />

    <node pkg="slam_toolbox" exec="async_slam_toolbox_node"
        name="slam_toolbox" output="screen">

        <param from="$(var slam_params_file)"></param>
    </node>

    <node pkg="nav2_lifecycle_manager"
          exec="lifecycle_manager"
          name="lifecycle_manager_slam"
          output="screen">

        <param name="autostart" value="true" />
        <param name="node_names"
               value="['slam_toolbox']" />

    </node>

</launch>